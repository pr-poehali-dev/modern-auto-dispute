{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST register - missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "email": "test@test.com"},
      "expectedStatus": 400
    },
    {
      "name": "POST login - bad credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "no@no.com", "password": "wrongpassword"},
      "expectedStatus": 401
    },
    {
      "name": "POST me - no session",
      "method": "POST",
      "path": "/",
      "body": {"action": "me"},
      "expectedStatus": 401
    }
  ]
}